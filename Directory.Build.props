<Project>
  <!-- La version de la suite vit ici, à un seul endroit : les huit exécutables la portent (propriétés du fichier) et installer\build.ps1 la lit pour nommer l'installeur. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Company>Valentin Large</Company>
    <Product>CDX</Product>
    <Copyright>© Valentin Large</Copyright>
  </PropertyGroup>
  <!-- Filets du compilateur (audit du 03/11/2026, lot 4.5) : une tâche lancée sans await ni « _ = » est une erreur (son exception se perdrait).
       Nullable s'active projet par projet : Cdx.Host l'est (121 avertissements traités) ; les programmes suivront, puis les analyseurs « recommended ». -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CS4014</WarningsAsErrors>
  </PropertyGroup>
</Project>
