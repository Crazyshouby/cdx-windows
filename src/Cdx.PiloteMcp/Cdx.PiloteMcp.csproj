<Project Sdk="Microsoft.NET.Sdk">

  <!-- Le serveur MCP « cdx-suite » que Claude Code lance pour Pilote : un relais JSON-RPC (entrée et sortie standard) vers le tube des outils de cdx-pilote.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>cdx-pilote-mcp</AssemblyName>
    <RootNamespace>Cdx.PiloteMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
