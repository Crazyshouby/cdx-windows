<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ce que partagent les trois programmes de la suite (kdx-shell, kdx-explorer, kdx-browser) : fenêtre hôte d'une page WebView2, appels Windows,
       journal, instance unique, canal de test, boutons latéraux de la souris. Les types restent internes : seuls les trois programmes les voient. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Kdx.Host</AssemblyName>
    <RootNamespace>Kdx</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <InternalsVisibleTo Include="kdx-shell" />
    <InternalsVisibleTo Include="kdx-explorer" />
    <InternalsVisibleTo Include="kdx-browser" />
  </ItemGroup>

</Project>
