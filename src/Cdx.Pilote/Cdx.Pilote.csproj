<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pilote : le chat avec Claude réservé à l'organisation et à la création des projets ; Claude Code en sous-processus, les applications de la suite en outils. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>cdx-pilote</AssemblyName>
    <RootNamespace>Cdx</RootNamespace>
    <ApplicationIcon>..\..\icons\pilote.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cdx.Host\Cdx.Host.csproj" />
  </ItemGroup>

</Project>
